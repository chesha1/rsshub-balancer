{
  "name": "rsshub-balancer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "NX_ISOLATE_PLUGINS=false NX_DAEMON=false nx run @rsshub-balancer/server:dev",
    "dev:web": "NX_LOAD_DOT_ENV_FILES=false NX_RUN_COMMANDS_DIRECTLY=false NX_ISOLATE_PLUGINS=false NX_DAEMON=false nx run @rsshub-balancer/web:dev",
    "build": "NX_ISOLATE_PLUGINS=false NX_DAEMON=false nx run-many -t build",
    "typecheck": "NX_ISOLATE_PLUGINS=false NX_DAEMON=false nx run-many -t typecheck",
    "lint": "NX_ISOLATE_PLUGINS=false NX_DAEMON=false nx run-many -t lint",
    "lint:fix": "biome check --fix . --files-ignore-unknown=true",
    "deploy": "NX_ISOLATE_PLUGINS=false NX_DAEMON=false nx run @rsshub-balancer/server:deploy",
    "cf-typegen": "NX_ISOLATE_PLUGINS=false NX_DAEMON=false nx run @rsshub-balancer/server:cf-typegen",
    "dev:node": "NX_LOAD_DOT_ENV_FILES=false NX_RUN_COMMANDS_DIRECTLY=false NX_ISOLATE_PLUGINS=false NX_DAEMON=false nx run @rsshub-balancer/server:dev:node",
    "start:node": "NX_LOAD_DOT_ENV_FILES=false NX_RUN_COMMANDS_DIRECTLY=false NX_ISOLATE_PLUGINS=false NX_DAEMON=false nx run @rsshub-balancer/server:start:node",
    "build:node": "NX_ISOLATE_PLUGINS=false NX_DAEMON=false nx run @rsshub-balancer/server:build:node",
    "build:worker": "NX_ISOLATE_PLUGINS=false NX_DAEMON=false nx run @rsshub-balancer/server:build:worker"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@types/node": "^26.5.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "nx": "^23.2.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.129.0"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=26.8.2 <27"
  }
}
